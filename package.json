{
  "name": "inei",
  "version": "3.0.0",
  "description": "EXIF and XMP metadata parser for JPEG, PNG, and HEIC/HEIF/AVIF. Zero dependencies. TypeScript.",
  "main": "dist/index.js",
  "type": "module",
  "homepage": "https://github.com/rajbirjohar/inei#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajbirjohar/inei.git"
  },
  "bugs": {
    "url": "https://github.com/rajbirjohar/inei/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./format": {
      "import": "./dist/format.js",
      "types": "./dist/format.d.ts"
    },
    "./format-tags": {
      "import": "./dist/format-tags.js",
      "types": "./dist/format-tags.d.ts"
    },
    "./xmp": {
      "import": "./dist/xmp.js",
      "types": "./dist/xmp.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx demo/index.ts",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "pnpm build:js && pnpm build:types",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "release:version": "changeset version && pnpm install",
    "release:publish": "changeset publish",
    "release": "pnpm run release:version && pnpm build && pnpm run release:publish"
  },
  "keywords": [
    "exif",
    "exif-parser",
    "exif-reader",
    "xmp",
    "metadata",
    "image-metadata",
    "image",
    "photo",
    "parser",
    "jpeg",
    "jpg",
    "png",
    "heic",
    "heif",
    "avif",
    "gps",
    "orientation",
    "thumbnail",
    "camera",
    "photography",
    "typescript"
  ],
  "author": {
    "name": "Rajbir Johar",
    "url": "https://github.com/rajbirjohar"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.4.1",
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@changesets/cli": "2.31.0",
    "@microsoft/api-extractor": "7.58.7",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "4.1.5",
    "lefthook": "2.1.6",
    "lint-staged": "16.4.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "ultracite": "7.6.0",
    "vite": "8.0.9",
    "vitest": "4.1.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss}": [
      "ultracite fix"
    ]
  }
}
